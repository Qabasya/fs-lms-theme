{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fs-lms/catalog-card",
	"title": "Карточка направления (каталог)",
	"category": "fs-lms-cards",
	"icon": "grid-view",
	"description": "Развёрнутая карточка направления для страницы «Курсы»: обложка, класс, формат, описание, теги, цена с примечанием и кнопка.",
	"keywords": [ "курс", "направление", "каталог", "карточка", "catalog" ],
	"textdomain": "fs-lms-theme",
	"attributes": {
		"imageId": { "type": "number", "default": 0 },
		"imageUrl": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"badgeText": { "type": "string", "source": "html", "selector": ".fs-course-catalog-card__badge", "default": "11 класс" },
		"badgeColor": { "type": "string", "default": "accent" },
		"formatText": { "type": "string", "source": "html", "selector": ".fs-course-catalog-card__format", "default": "2 раза в неделю" },
		"title": { "type": "string", "source": "html", "selector": ".fs-course-catalog-card__title", "default": "Название направления" },
		"text": { "type": "string", "source": "html", "selector": ".fs-course-catalog-card__text", "default": "Короткое описание программы направления." },
		"tags": { "type": "string", "default": "" },
		"priceAmount": { "type": "string", "source": "html", "selector": ".fs-course-catalog-card__price-amount", "default": "6 400 ₽" },
		"priceNote": { "type": "string", "source": "html", "selector": ".fs-course-catalog-card__price-note", "default": "800 ₽ за час, занятие 2 часа" },
		"buttonText": { "type": "string", "default": "Подробнее" },
		"buttonUrl": { "type": "string", "default": "#" },
		"grade": { "type": "string", "default": "" }
	},
	"supports": { "html": false },
	"editorScript": "fs-lms-catalog-card-editor-script",
	"style": "fs-lms-catalog-card-style"
}
