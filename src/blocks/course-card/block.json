{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fs-lms/course-card",
	"title": "Карточка курса",
	"category": "fs-lms-cards",
	"icon": "welcome-learn-more",
	"description": "Картинка, бейдж уровня, название, формат, цена и кнопка записи — карточка одного курса/направления.",
	"keywords": [ "курс", "направление", "карточка", "course" ],
	"textdomain": "fs-lms-theme",
	"attributes": {
		"imageId": { "type": "number", "role": "content", "default": 0 },
		"imageUrl": { "type": "string", "role": "content", "default": "" },
		"imageAlt": { "type": "string", "role": "content", "default": "" },
		"badgeText": { "type": "string", "role": "content", "source": "html", "selector": ".fs-course-card__badge", "default": "9 класс" },
		"badgeColor": { "type": "string", "default": "accent" },
		"title": { "type": "string", "role": "content", "source": "html", "selector": "h3", "default": "Название курса" },
		"caption": { "type": "string", "role": "content", "source": "html", "selector": ".fs-course-card__caption", "default": "Абонемент на месяц, два занятия в неделю" },
		"price": { "type": "string", "role": "content", "source": "html", "selector": ".fs-course-card__price-amount", "default": "" },
		"priceUnit": { "type": "string", "role": "content", "source": "html", "selector": ".fs-course-card__price-unit", "default": "/ мес" },
		"buttonText": { "type": "string", "role": "content", "default": "Подробнее" },
		"buttonUrl": { "type": "string", "role": "content", "default": "#" }
	},
	"supports": { "html": false },
	"editorScript": "fs-lms-course-card-editor-script",
	"style": "fs-lms-course-card-style"
}
