{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "name": "Акцент", "slug": "accent", "color": "#3b5bdb" },
				{ "name": "Акцент (hover)", "slug": "accent-600", "color": "#2f44b3" },
				{ "name": "Акцент (текст)", "slug": "accent-700", "color": "#2f44b3" },
				{ "name": "Акцент (мягкий)", "slug": "accent-soft", "color": "#edf2ff" },
				{ "name": "Акцент 2", "slug": "accent-2", "color": "#de5904" },
				{ "name": "Акцент 2 (hover)", "slug": "accent-2-600", "color": "#bd4c03" },
				{ "name": "Акцент 2 (мягкий)", "slug": "accent-2-soft", "color": "#faf5ee" },
				{ "name": "Фон страницы", "slug": "bg", "color": "#f3f4f7" },
				{ "name": "Поверхность", "slug": "white", "color": "#ffffff" },
				{ "name": "Поверхность 2", "slug": "surface-2", "color": "#fafbfc" },
				{ "name": "Текст", "slug": "text", "color": "#181b23" },
				{ "name": "Текст (вторичный)", "slug": "text-secondary", "color": "#3c424e" },
				{ "name": "Приглушённый", "slug": "muted", "color": "#6b7280" },
				{ "name": "Приглушённый 2", "slug": "muted-2", "color": "#9aa1ad" },
				{ "name": "Рамка", "slug": "border", "color": "#e7e9ef" },
				{ "name": "Рамка (лёгкая)", "slug": "border-light", "color": "#eef0f4" },
				{ "name": "Успех", "slug": "ok", "color": "#2f9e44" },
				{ "name": "Успех (мягкий)", "slug": "ok-soft", "color": "#e9f7ee" },
				{ "name": "Ошибка", "slug": "err", "color": "#e03131" },
				{ "name": "Ошибка (мягкий)", "slug": "err-soft", "color": "#fdecec" },
				{ "name": "Ожидание", "slug": "wait", "color": "#b36b00" },
				{ "name": "Ожидание (мягкий)", "slug": "wait-soft", "color": "#fdf3e3" },
				{ "name": "Информация", "slug": "info", "color": "#1c7ed6" },
				{ "name": "Информация (мягкий)", "slug": "info-soft", "color": "#e7f2fd" },
				{ "name": "Видео", "slug": "violet", "color": "#7048e8" },
				{ "name": "Видео (мягкий)", "slug": "violet-soft", "color": "#f1ecfd" },
				{ "name": "Практика", "slug": "practice", "color": "#e8590c" },
				{ "name": "Практика (мягкий)", "slug": "practice-soft", "color": "#fdeee3" },
				{ "name": "Направление — синий", "slug": "subject-blue", "color": "#c5d9ed" },
				{ "name": "Направление — жёлтый", "slug": "subject-yellow", "color": "#f5e6ab" },
				{ "name": "Направление — жёлтый (текст)", "slug": "subject-yellow-text", "color": "#a67c00" },
				{ "name": "Направление — зелёный", "slug": "subject-green", "color": "#b8e6bf" },
				{ "name": "Направление — фиолетовый", "slug": "subject-purple", "color": "#ede9fe" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "'Ubuntu', arial, helvetica, sans-serif",
					"name": "Ubuntu (интерфейс)",
					"slug": "ui",
					"fontFace": [
						{
							"fontFamily": "Ubuntu",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" ]
						}
					]
				},
				{
					"fontFamily": "'Courier New', courier, monospace",
					"name": "Моноширинный",
					"slug": "code"
				}
			],
			"fontSizes": [
				{ "name": "2XS (14px)", "slug": "xxs", "size": "calc(14rem / 19.2)" },
				{ "name": "XS (15px)", "slug": "xs", "size": "calc(15rem / 19.2)" },
				{ "name": "SM (14px)", "slug": "sm", "size": "calc(14rem / 19.2)" },
				{ "name": "Base (16px)", "slug": "base", "size": "calc(16rem / 19.2)" },
				{ "name": "MD (18px)", "slug": "md", "size": "calc(18rem / 19.2)" },
				{ "name": "Lead (21px)", "slug": "lead", "size": "calc(21rem / 19.2)" },
				{ "name": "LG (22px)", "slug": "lg", "size": "calc(22rem / 19.2)" },
				{ "name": "XL (24px)", "slug": "xl", "size": "calc(24rem / 19.2)" },
				{ "name": "2XL (36px, заголовок)", "slug": "xxl", "size": "calc(36rem / 19.2)" },
				{ "name": "3XL (56px)", "slug": "xxxl", "size": "calc(56rem / 19.2)" }
			],
			"fontWeight": true,
			"lineHeight": true
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "name": "XS", "slug": "xs", "size": "0.25rem" },
				{ "name": "SM", "slug": "sm", "size": "0.5rem" },
				{ "name": "MD", "slug": "md", "size": "0.75rem" },
				{ "name": "LG", "slug": "lg", "size": "1rem" },
				{ "name": "XL", "slug": "xl", "size": "1.25rem" },
				{ "name": "2XL", "slug": "xxl", "size": "1.5rem" },
				{ "name": "3XL", "slug": "xxxl", "size": "1.75rem" },
				{ "name": "4XL", "slug": "xxxxl", "size": "2rem" }
			]
		},
		"border": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true
		},
		"custom": {
			"radius": {
				"sm": "0.25rem",
				"md": "0.375rem",
				"lg": "0.5rem",
				"xl": "0.75rem",
				"xxl": "1rem",
				"pill": "999px",
				"card": "0.875rem",
				"control": "0.5625rem"
			},
			"shadow": {
				"surface": "0 1px 2px rgba(16, 24, 40, .05), 0 1px 3px rgba(16, 24, 40, .05)",
				"hover": "0 4px 12px rgba(16, 24, 40, .08), 0 2px 4px rgba(16, 24, 40, .04)"
			}
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ui)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.2"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-600)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700"
				},
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--white)",
					"background": "var(--wp--preset--color--accent-2)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--control)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-2-600)"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"right": "2.5rem",
				"bottom": "0",
				"left": "2.5rem"
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Шапка", "area": "header" },
		{ "name": "footer", "title": "Подвал", "area": "footer" }
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Страница (широкая, 1200px)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-subject",
			"title": "Страница без заголовка (1200px)",
			"postTypes": [ "page" ]
		}
	]
}
